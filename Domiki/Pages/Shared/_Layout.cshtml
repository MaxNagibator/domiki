<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color"
          content="#40632f" />
    <title>@ViewData["Title"] – Домики</title>
    <link rel="preload"
          href="/fonts/golos-text-cyrillic.woff2"
          as="font"
          type="font/woff2"
          crossorigin />
    <link rel="preload"
          href="/fonts/press-start-2p-cyrillic.woff2"
          as="font"
          type="font/woff2"
          crossorigin />
    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />
</head>
<body>
    <main class="auth-page">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", false)
</body>
</html>
